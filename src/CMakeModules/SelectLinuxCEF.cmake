# Select packaged CEF in priority order, falling back to downloads only in AUTO/OFF mode.
set(USE_SYSTEM_CEF AUTO CACHE STRING "CEF source: AUTO prefers CasparCG then distro packages; ON requires a package; OFF downloads CEF")
set_property(CACHE USE_SYSTEM_CEF PROPERTY STRINGS AUTO ON OFF)
# Accept legacy boolean values without replacing the user's cached source policy.
string(TOUPPER "${USE_SYSTEM_CEF}" USE_SYSTEM_CEF)
if(USE_SYSTEM_CEF MATCHES "^(1|TRUE|YES|Y)$")
    set(USE_SYSTEM_CEF ON)
elseif(USE_SYSTEM_CEF MATCHES "^(0|FALSE|NO|N|IGNORE|NOTFOUND|)$")
    set(USE_SYSTEM_CEF OFF)
endif()
if(NOT USE_SYSTEM_CEF MATCHES "^(AUTO|ON|OFF)$")
    message(FATAL_ERROR "USE_SYSTEM_CEF must be AUTO, ON or OFF")
endif()

if(NOT USE_SYSTEM_CEF STREQUAL "OFF")
    find_package(casparcg-cef-api15000 CONFIG QUIET)
    if(casparcg-cef-api15000_FOUND)
        add_library(CEF::CEF INTERFACE IMPORTED)
        target_link_libraries(CEF::CEF INTERFACE CasparCG::CEF)
        set(USE_SYSTEM_CEF ON)
        message(STATUS "CEF source: CasparCG package (API 15000)")
    else()
        set(CEF_API_VERSION 15000)
        find_package(CEF 150 MODULE QUIET)
        if(CEF_FOUND AND TARGET CEF::Library AND TARGET CEF::Wrapper)
            add_library(CEF::CEF INTERFACE IMPORTED)
            target_link_libraries(CEF::CEF INTERFACE CEF::Library CEF::Wrapper)
            target_compile_definitions(CEF::CEF INTERFACE CEF_API_VERSION=${CEF_API_VERSION})
            set(USE_SYSTEM_CEF ON)
            message(STATUS "CEF source: distro package (${CEF_VERSION}, API 15000)")
        elseif(USE_SYSTEM_CEF STREQUAL "ON")
            message(FATAL_ERROR "No compatible CEF package found. Install casparcg-cef-api15000 or distro CEF 150+, or use -DUSE_SYSTEM_CEF=OFF to download CEF.")
        else()
            # Some distro find modules create a wrapper before checking its version.
            if(TARGET libcef_dll_wrapper)
                set_target_properties(libcef_dll_wrapper PROPERTIES EXCLUDE_FROM_ALL TRUE)
            endif()
            set(USE_SYSTEM_CEF OFF)
            message(STATUS "No compatible CEF package found; downloading CEF and building its API 15000 wrapper")
        endif()
    endif()
else()
    message(STATUS "CEF source: downloaded runtime and locally built API 15000 wrapper")
endif()

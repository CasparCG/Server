#!/usr/bin/make -f
%:
	dh $@ --sourcedirectory=src --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -DDIAG_FONT_PATH=/usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf -DCASPARCG_BINARY_NAME=casparcg-server-beta -DOMT_BUILD_FROM_SOURCE=OFF -DUSE_SYSTEM_CEF=OFF

# The prebuilt CEF binaries carry DWARF 5 debug sections (.debug_addr) that dwz cannot
# read yet (https://bugs.debian.org/1016936). dh_strip still runs normally afterwards.
override_dh_dwz:

# Generate and install manual page
debian/casparcg-server-beta.1: debian/casparcg.txt2man
	txt2man -t CASPARCG -d 2018-12-14 -s 1 debian/casparcg.txt2man > $@

override_dh_installman: debian/casparcg-server-beta.1
	dh_installman
	$(RM) debian/casparcg-server-beta.1
